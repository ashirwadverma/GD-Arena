# GD Arena - Environment Variables
# Copy this file to .env and configure your keys

# Primary LLM Provider (Google Gemini Recommended: Free Tier available)
GEMINI_API_KEY=

# Fallback LLM Providers (Optional - Canned lines provide offline reliability if keys are missing)
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional Cloud TTS (Tier B quality upgrade, e.g. ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# App Configuration
NEXT_PUBLIC_APP_NAME="GD Arena"
NEXT_PUBLIC_APP_VERSION="1.0.0"
